{
  "type": "record",
  "name": "bentechSinkWorkdayKafkaPublish",
  "namespace": "com.standardinsurance.eoi",
  "fields": [
    {"name": "flattenedEvent",       "type": ["null", "string"], "default": null, "doc": "Full source event payload serialized as a JSON string"},
