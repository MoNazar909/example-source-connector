    {"name": "targetBentechPayload", "type": ["null", "string"], "default": null, "doc": "bentech-specific request payload (e.g. Workday SOAP XML) serialized as a string"},
    {"name": "targetBentech",        "type": ["null", "string"], "default": null},
    {"name": "groupId",              "type": ["null", "string"], "default": null},
    {"name": "eventType",            "type": ["null", "string"], "default": null},
    {"name": "correlationId",        "type": ["null", "string"], "default": null}
  ]
}
