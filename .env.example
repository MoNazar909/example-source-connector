# -----------------------------------------------------------------------
# Copy this file to .env and fill in the standard-connect-sa credentials.
# .env is gitignored — never commit it.
# Used only by docker-compose.yml (the Connect worker).
# -----------------------------------------------------------------------

# Kafka cluster bootstrap server (same value goes in connector-config.json)
KAFKA_BOOTSTRAP_SERVER=<KAFKA_BOOTSTRAP_SERVER>   # e.g. pkc-xxx.us-east-2.aws.confluent.cloud:9092

# standard-connect-sa — Kafka API key (managed_resource_kind: Cluster)
CONNECT_SA_KAFKA_API_KEY=<CONNECT_SA_KAFKA_API_KEY>
CONNECT_SA_KAFKA_API_SECRET=<CONNECT_SA_KAFKA_API_SECRET>
